# Required for authenticated durable workspace. Never commit real credentials.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Worker endpoints require a strong random value (at least 32 characters).
CRON_SECRET=
# Evidence encryption: 32 bytes, base64. Generate with openssl rand -base64 32.
DOCUMENT_ENCRYPTION_KEY=
# Read-only RPC. Must match the selected chain and verified token deployment.
ARC_RPC_URL=https://rpc.testnet.arc.network
# Integration providers are disabled until configured and compatibility verified.
# Default preserves existing OpenAI deployments. Set deepseek explicitly for DeepSeek.
MODEL_PROVIDER=openai
MODEL_NAME=
# Preferred single selected-provider secret; legacy OpenAI name remains compatible.
MODEL_API_KEY=
# Optional provider-specific alternatives; used only for the selected provider.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek example: MODEL_PROVIDER=deepseek, MODEL_NAME=deepseek-flash.
# Private portable-pilot keys are separate from web credentials and require consent/spend opt-ins.
COUNTERSIGN_PILOT_OPENAI_API_KEY=
COUNTERSIGN_PILOT_DEEPSEEK_API_KEY=
COUNTERSIGN_MODULE_ADDRESS=
EXECUTION_ENABLED=false
CIRCLE_COMPATIBILITY_VERIFIED=false
ARC_CHAIN_ID=5042002
USDC_TOKEN_ADDRESS=
# Circle CLI is installed on the separate persistent worker, not the web function.
CIRCLE_CLI_PATH=circle
CIRCLE_AGENT_WALLET=
CIRCLE_CHAIN=ARC-TESTNET
SOURCE_CHAIN_ID=5042002
SOURCE_RPC_URL=
SAFE_ADDRESS=
EXECUTION_ORGANIZATION_ID=
CIRCLE_REVOCATION_VERIFIED=false
EXECUTION_SECURITY_REVIEW_APPROVED=false
# Isolated verifier key; NEVER use the Circle executor or Safe owner key here.
VERIFIER_PRIVATE_KEY=
EXECUTION_MANIFEST_PATH=
CCTP_DESTINATION_DOMAIN=
DESTINATION_RPC_URL=
CCTP_SOURCE_DOMAIN=
CCTP_SOURCE_MESSENGER=
CCTP_DESTINATION_MESSENGER=
CCTP_SOURCE_ADAPTER=
CCTP_DESTINATION_TRANSMITTER=
CCTP_DESTINATION_TOKEN=
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alternative for serverless web deployments: private JSON manifest in a secret env var.
EXECUTION_MANIFEST_JSON=
