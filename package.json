{
  "name": "countersign",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "forge test --root contracts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test -- --maxWorkers=2 && npm run test:contracts && npm run build && npm run check:boundary",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:operations": "tsx scripts/operations-worker.ts",
    "receipt:verify": "tsx scripts/verify-receipt.ts",
    "check:boundary": "node scripts/check-boundary.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "pilot": "tsx scripts/pilot.ts",
    "doctor": "tsx scripts/doctor.ts",
    "activation:check": "tsx scripts/activation-check.ts",
    "db:restore:verify": "tsx scripts/restore-check.ts"
  },
  "dependencies": {
    "jose": "6.1.3",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.11",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  }
}
