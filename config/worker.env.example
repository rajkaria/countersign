# Persistent worker host. Populate privately; never copy the verifier's key here.
NODE_ENV=production
DATABASE_URL=
APP_ORIGIN=
CRON_SECRET=
EXECUTION_ENABLED=false
SOURCE_RPC_URL=
CIRCLE_CLI_PATH=circle
CIRCLE_CLI_HOME=/home/node/.circle
EXECUTION_MANIFEST_PATH=/run/countersign/deployment.json
# Optional destination relay. Keep disabled until route compatibility and recovery are reviewed.
RELAY_CONFIG_PATH=
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# VERIFIER_PRIVATE_KEY is intentionally absent from this worker template.
